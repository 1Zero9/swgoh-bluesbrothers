generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GuildEventType {
  TERRITORY_BATTLE
  TERRITORY_WAR
  RAID
}

enum MembershipState {
  ACTIVE
  LEFT
}

enum AutomationStatus {
  PENDING
  SENT
  FAILED
  ACKNOWLEDGED
}

enum RecipeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TwPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TwAssignmentStatus {
  SUGGESTED
  ASSIGNED
  ACKNOWLEDGED
  PLACED
  CHANGED
  MISSING
  EXEMPT
}

enum TwAssignmentSource {
  RECOMMENDED
  MANUAL
}

enum TwAttackStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  FAILED
  NEEDS_SPECIALIST
  CLEARED
  HOLD
}

model Guild {
  id               String            @id
  name             String
  discordGuildId   String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  snapshots        GuildSnapshot[]
  membershipTerms  MembershipTerm[]
  events           GuildEvent[]
  automationEvents AutomationEvent[]
  twTemplates      StrategyTemplate[]
  twPlans          TerritoryWarPlan[]
  twCommands       TwCommand[]
  tbPlans          TerritoryBattlePlan[]
  tbCallouts       TbCallout[]
}

model Player {
  id               String            @id
  allyCode         String?           @unique
  currentName      String
  discordUserId    String?           @unique
  level            Int?
  portraitId       String?
  titleId          String?
  profileSyncedAt  DateTime?
  profilePayload   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  names            PlayerName[]
  membershipTerms  MembershipTerm[]
  snapshots        MemberSnapshot[]
  automationEvents AutomationEvent[]
  profileSnapshots PlayerProfileSnapshot[]
  wins             GuildWin[]
  extraDiscordAccounts PlayerDiscordAccount[]
  pushSubscriptions PushSubscription[]
  twAssignments    PlayerAssignment[]
  twAttackAssignments AttackAssignment[]
}

model PlayerName {
  id        String   @id @default(cuid())
  playerId  String
  name      String
  firstSeen DateTime
  lastSeen  DateTime
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, lastSeen])
}

model MembershipTerm {
  id                  String          @id @default(cuid())
  guildId             String
  playerId            String
  state               MembershipState @default(ACTIVE)
  joinedAt            DateTime
  leftAt              DateTime?
  welcomeSentAt       DateTime?
  departureNotifiedAt DateTime?
  discordAccessRemovedAt DateTime?
  guild               Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player              Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guildId, playerId, joinedAt])
  @@index([guildId, state])
}

model GuildSnapshot {
  id             String           @id @default(cuid())
  guildId        String
  capturedAt     DateTime
  memberCount    Int
  galacticPower  BigInt
  characterPower BigInt
  shipPower      BigInt
  raidTickets    Int?
  rawPayload     Json?
  guild          Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members        MemberSnapshot[]

  @@unique([guildId, capturedAt])
  @@index([capturedAt])
}

model MemberSnapshot {
  id              String        @id @default(cuid())
  guildSnapshotId String
  playerId        String
  galacticPower   BigInt
  characterPower  BigInt?
  shipPower       BigInt?
  raidTickets     Int?
  lastActivityAt  DateTime?
  playerLevel     Int?
  memberRole      String?
  squadPower      Int?
  lifetimeSeasonScore BigInt?
  leagueId        String?
  guildXp         Int?
  rawPayload      Json?
  guildSnapshot   GuildSnapshot @relation(fields: [guildSnapshotId], references: [id], onDelete: Cascade)
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guildSnapshotId, playerId])
  @@index([playerId])
}

model PlayerProfileSnapshot {
  id                 String   @id @default(cuid())
  playerId           String
  capturedAt         DateTime @default(now())
  galacticLegends    Int
  unlockedUltimates  Int
  relicUnits         Int
  rosterUnits        Int
  datacrons          Int
  lifetimeSeasonScore BigInt?
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, capturedAt])
  @@index([capturedAt])
}

model GuildEvent {
  id          String         @id @default(cuid())
  guildId     String
  externalId  String?
  type        GuildEventType
  name        String
  startsAt    DateTime?
  endsAt      DateTime?
  finalResult Json?
  guild       Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  snapshots   EventSnapshot[]
  twPlans     TerritoryWarPlan[]
  tbPlans     TerritoryBattlePlan[]

  @@unique([guildId, type, externalId])
  @@index([guildId, type, startsAt])
}

model EventSnapshot {
  id         String     @id @default(cuid())
  eventId    String
  capturedAt DateTime
  phase      String?
  payload    Json
  event      GuildEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, capturedAt])
}

model AutomationEvent {
  id               String           @id @default(cuid())
  guildId          String
  playerId         String?
  kind             String
  status           AutomationStatus @default(PENDING)
  title            String?
  summary          String
  metadata         Json?
  discordChannelId String?
  discordMessageId String?
  occurredAt       DateTime         @default(now())
  sentAt           DateTime?
  guild            Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player           Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([guildId, occurredAt])
  @@index([status, occurredAt])
}

model Recipe {
  id           String   @id
  slug         String   @unique
  name         String
  origin       String
  description  String
  ingredients  Json
  instructions Json
  beerPairings Json
  tone         String
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model RecipeSubmission {
  id            String                 @id @default(cuid())
  name          String
  origin        String?
  bread         String
  filling       String
  toppings      String
  instructions  String
  beerSuggestion String?
  submitterName String?
  notes         String?
  status        RecipeSubmissionStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, createdAt])
}

model TwCommand {
  id          String       @id @default(cuid())
  guildId     String
  name        String
  squadKey    String?
  kitNotes    String?
  isBuiltIn   Boolean      @default(false)
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  zonePlans   ZonePlan[]
  planetPlans PlanetPlan[]

  @@index([guildId])
}

model StrategyTemplate {
  id          String             @id @default(cuid())
  guildId     String
  name        String
  description String?
  isBuiltIn   Boolean            @default(false)
  rules       Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  guild       Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plans       TerritoryWarPlan[]

  @@index([guildId])
}

model TerritoryWarPlan {
  id            String            @id @default(cuid())
  guildId       String
  eventId       String?
  templateId    String?
  clonedFromId  String?
  name          String
  status        TwPlanStatus      @default(DRAFT)
  version       Int               @default(1)
  createdBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  guild         Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  event         GuildEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  template      StrategyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  clonedFrom    TerritoryWarPlan? @relation("PlanClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones        TerritoryWarPlan[] @relation("PlanClone")
  zonePlans     ZonePlan[]
  assignments   PlayerAssignment[]
  attackAssignments AttackAssignment[]

  @@index([guildId, status])
  @@index([eventId])
}

model ZonePlan {
  id             String             @id @default(cuid())
  planId         String
  zoneId         Int
  purpose        String?
  targetCapacity Int                @default(25)
  note           String?
  commandId      String?
  updatedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  plan           TerritoryWarPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  command        TwCommand?         @relation(fields: [commandId], references: [id], onDelete: SetNull)
  assignments    PlayerAssignment[]

  @@unique([planId, zoneId])
  @@index([commandId])
}

model PlayerAssignment {
  id           String              @id @default(cuid())
  planId       String
  zonePlanId   String
  playerId     String
  squadKey     String
  priority     Int                 @default(0)
  officerNote  String?
  status       TwAssignmentStatus  @default(SUGGESTED)
  source       TwAssignmentSource  @default(RECOMMENDED)
  locked       Boolean             @default(false)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  plan         TerritoryWarPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  zonePlan     ZonePlan            @relation(fields: [zonePlanId], references: [id], onDelete: Cascade)
  player       Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([planId, zonePlanId])
  @@index([playerId])
}

model AttackAssignment {
  id               String          @id @default(cuid())
  planId           String
  zoneLabel        String
  enemySquad       String?
  assignedPlayerId String?
  status           TwAttackStatus  @default(UNASSIGNED)
  note             String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  plan             TerritoryWarPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignedPlayer   Player?          @relation(fields: [assignedPlayerId], references: [id], onDelete: SetNull)

  @@index([planId])
}

enum TbStrategy {
  PRELOAD
  THREE_STAR
  HOLD
  SKIP
}

model TerritoryBattlePlan {
  id          String       @id @default(cuid())
  guildId     String
  eventId     String?
  name        String
  status      TwPlanStatus @default(DRAFT)
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  event       GuildEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  planetPlans PlanetPlan[]

  @@index([guildId, status])
  @@index([eventId])
}

model PlanetPlan {
  id         String              @id @default(cuid())
  planId     String
  planetName String
  phase      Int                 @default(1)
  strategy   TbStrategy          @default(PRELOAD)
  commandId  String?
  note       String?
  priority   Int                 @default(0)
  updatedBy  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  plan       TerritoryBattlePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  command    TwCommand?          @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([planId, phase])
  @@index([commandId])
}

model GuildWin {
  id         String   @id @default(cuid())
  playerId   String
  kind       String
  subject    String   @default("")
  value      Int
  occurredAt DateTime
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, kind, subject, value])
  @@index([occurredAt])
}

model TbCallout {
  id         String    @id @default(cuid())
  guildId    String
  unitId     String
  unitName   String
  minStars   Int       @default(7)
  minRelic   Int       @default(0)
  needed     Int?
  phase      Int?
  planetName String?
  note       String?
  status     String    @default("OPEN")
  createdBy  String?
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}

/// Additional Discord accounts for one in-game player (the primary stays on Player.discordUserId).
model PlayerDiscordAccount {
  id            String   @id @default(cuid())
  playerId      String
  discordUserId String   @unique
  createdAt     DateTime @default(now())
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

/// A browser or installed-app notification subscription belonging to a member.
model PushSubscription {
  id             String    @id @default(cuid())
  playerId       String
  endpoint       String    @unique
  p256dh         String
  auth           String
  /// Which kinds of notification this device wants: "chat" (messages sent from the site) and "droid" (automatic posts).
  topics         String[]
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

/// A counter squad the guild has found for an enemy squad (identified by its leader), for Territory War and GAC.
model Counter {
  id            String   @id @default(cuid())
  enemyLeaderId String
  title         String
  mode          String   @default("BOTH")
  /// [{ unitId, minStars, minRelic }], leader first.
  squad         Json
  notes         String?
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())

  @@index([enemyLeaderId])
  @@index([createdAt])
}

/// How many questions a member has put to B-Lue3 on a given (UTC) day. Keeps the AI bill predictable.
model BlueUsage {
  id    String @id @default(cuid())
  /// The member's player id, or "officer" for a shared-password officer session.
  who   String
  /// UTC day, YYYY-MM-DD.
  day   String
  count Int    @default(0)

  @@unique([who, day])
}

// ── Counter knowledge base ────────────────────────────────────────────────────────────────────
// Team templates, exact variants, match-ups, immutable evidence and a review lifecycle.
// Statuses/modes are validated strings (see lib/knowledge/modes.ts and lifecycle.ts), like the rest of this schema.

/// A named team family, e.g. "Lord Vader" (ground) or "Executor" (fleet).
model KbTeam {
  id           String      @id @default(cuid())
  /// Stable slug, unique.
  key          String      @unique
  name         String
  /// Common names and abbreviations members type, e.g. "GAS", "501st".
  aliases      String[]
  /// SQUAD or FLEET.
  kind         String      @default("SQUAD")
  leaderUnitId String?
  tags         String[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  variants     KbVariant[]

  @@index([leaderUnitId])
}

/// An exact composition of a team. `key` is derived from the kind, leader and members, so the same squad is never stored twice.
model KbVariant {
  id        String      @id @default(cuid())
  teamId    String
  key       String      @unique
  label     String?
  /// [{ unitId, role: LEADER|CORE|OPTIONAL|STARTING|REINFORCEMENT, alternatives?: [unitId] }]
  members   Json
  createdAt DateTime    @default(now())
  team      KbTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  asDefender KbMatchup[] @relation("MatchupDefender")
  asAttacker KbMatchup[] @relation("MatchupAttacker")

  @@index([teamId])
}

/// One attacking variant against one defending variant in one mode, with strategy and requirements.
model KbMatchup {
  id                String        @id @default(cuid())
  defenderId        String
  attackerId        String
  /// GAC_5V5, GAC_3V3, TW, GAC_FLEET or TW_FLEET.
  mode              String
  strategy          String?
  opening           String?
  targetPriority    String?
  failureConditions String?
  relicGuidance     String?
  speedNotes        String?
  /// null means unknown.
  oneShot           Boolean?
  freshEnemyOnly    Boolean?
  /// { zetas: string[], omicrons: string[], ultimates: string[], minRelic: { unitId: number } }
  requirements      Json?
  datacronDependent Boolean       @default(false)
  datacronExpiresAt DateTime?
  /// CANDIDATE, PUBLISHED, DISPUTED, OUTDATED or REJECTED.
  status            String        @default("CANDIDATE")
  /// MEMBER, BLUE, IMPORT or OFFICER.
  via               String
  submittedById     String?
  submittedByName   String
  /// "<source>:<id>" for imported rows, so a re-run updates instead of duplicating.
  importKey         String?       @unique
  supersedesId      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  defender          KbVariant     @relation("MatchupDefender", fields: [defenderId], references: [id])
  attacker          KbVariant     @relation("MatchupAttacker", fields: [attackerId], references: [id])
  evidence          KbEvidence[]
  events            KbEvent[]
  uses              KbUse[]

  @@index([status, mode])
  @@index([defenderId, mode])
  @@index([attackerId])
}

/// A fact about a match-up, tied to its own source and sample. Never edited after it is written; a newer
/// observation is a new row. Numbers are null when the source did not say (never zero).
model KbEvidence {
  id             String    @id @default(cuid())
  matchupId      String
  /// AGGREGATED, INDIVIDUAL_BATTLE, DEMONSTRATION, COMMUNITY_REPORT or THEORY.
  type           String
  sourceProvider String
  sourceUrl      String?
  sourceRef      String?
  attribution    String?
  publishedAt    DateTime?
  observedAt     DateTime?
  retrievedAt    DateTime  @default(now())
  mode           String?
  season         String?
  gameVersion    String?
  conditions     String?
  battles        Int?
  wins           Int?
  losses         Int?
  banners        Float?
  summary        String?
  createdAt      DateTime  @default(now())
  matchup        KbMatchup @relation(fields: [matchupId], references: [id], onDelete: Cascade)

  @@index([matchupId])
}

/// The change history of a match-up: who did what, when.
model KbEvent {
  id         String    @id @default(cuid())
  matchupId  String
  action     String
  actorName  String
  note       String?
  createdAt  DateTime  @default(now())
  matchup    KbMatchup @relation(fields: [matchupId], references: [id], onDelete: Cascade)

  @@index([matchupId])
}

/// "This is what I use": one mark per member per counter. A community signal, kept apart from battle evidence.
model KbUse {
  id        String    @id @default(cuid())
  matchupId String
  playerId  String
  createdAt DateTime  @default(now())
  matchup   KbMatchup @relation(fields: [matchupId], references: [id], onDelete: Cascade)

  @@unique([matchupId, playerId])
  @@index([playerId])
}

/// A call for help: a member needs a counter for a squad. Posted to a Discord channel when one is configured.
model KbRequest {
  id              String    @id @default(cuid())
  mode            String
  /// The enemy squad's leader; any published counter for this leader in this mode answers the request.
  leaderUnitId    String
  note            String?
  /// OPEN, ANSWERED (a counter for this squad and mode was published) or CLOSED.
  status          String    @default("OPEN")
  requestedById   String
  requestedByName String
  discordPosted   Boolean   @default(false)
  answeredById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, mode])
  @@index([leaderUnitId])
}

/// A tip or an idea from a member. Plain words, not a squad: "use your ticket at reset", "TW would be easier if...".
/// Follows the same lifecycle as counters (candidate, then published after an officer checks it).
model KbNote {
  id              String          @id @default(cuid())
  /// TIP or IDEA.
  kind            String
  title           String
  body            String
  /// A game area such as Territory War or Farming. Optional.
  topic           String?
  /// How the author knows: "I do this every war", "saw it in a video". Optional.
  howKnown        String?
  /// CANDIDATE, PUBLISHED, OUTDATED or REJECTED.
  status          String          @default("CANDIDATE")
  /// MEMBER or OFFICER.
  via             String
  submittedById   String?
  submittedByName String
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  helpful         KbNoteHelpful[]

  @@index([status, kind])
  @@index([submittedById])
}

/// "This helped me": one mark per member per note.
model KbNoteHelpful {
  id        String   @id @default(cuid())
  noteId    String
  playerId  String
  createdAt DateTime @default(now())
  note      KbNote   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, playerId])
  @@index([playerId])
}

/// The floating announcement on Home. One row (id "current"); officers edit it on the site. `version` goes up on every save so everyone sees a changed announcement again.
model Announcement {
  id            String   @id
  enabled       Boolean  @default(true)
  label         String
  title         String
  text          String
  cta           String
  href          String
  quote         String
  seconds       Int      @default(20)
  version       Int      @default(1)
  updatedByName String?
  updatedAt     DateTime @updatedAt
}

/// The guild's feedback and to-do board: members post feedback, feature requests and bugs; officers mark them off.
model FeedbackItem {
  id              String         @id @default(cuid())
  /// FEEDBACK, FEATURE or BUG.
  kind            String
  title           String
  body            String
  /// OPEN, PLANNED, IN_PROGRESS, DONE or DECLINED.
  status          String         @default("OPEN")
  /// An officer's note to the guild, shown on the item.
  reply           String?
  submittedById   String?
  submittedByName String
  statusByName    String?
  doneAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  votes           FeedbackVote[]

  @@index([status, createdAt])
  @@index([submittedById])
}

/// "Me too": one vote per member per item.
model FeedbackVote {
  id        String       @id @default(cuid())
  itemId    String
  playerId  String
  createdAt DateTime     @default(now())
  item      FeedbackItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, playerId])
  @@index([playerId])
}
