generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GuildEventType {
  TERRITORY_BATTLE
  TERRITORY_WAR
  RAID
}

enum MembershipState {
  ACTIVE
  LEFT
}

enum AutomationStatus {
  PENDING
  SENT
  FAILED
  ACKNOWLEDGED
}

enum RecipeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TwPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TwAssignmentStatus {
  SUGGESTED
  ASSIGNED
  ACKNOWLEDGED
  PLACED
  CHANGED
  MISSING
  EXEMPT
}

enum TwAssignmentSource {
  RECOMMENDED
  MANUAL
}

enum TwAttackStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  FAILED
  NEEDS_SPECIALIST
  CLEARED
  HOLD
}

model Guild {
  id               String            @id
  name             String
  discordGuildId   String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  snapshots        GuildSnapshot[]
  membershipTerms  MembershipTerm[]
  events           GuildEvent[]
  automationEvents AutomationEvent[]
  twTemplates      StrategyTemplate[]
  twPlans          TerritoryWarPlan[]
}

model Player {
  id               String            @id
  allyCode         String?           @unique
  currentName      String
  discordUserId    String?           @unique
  level            Int?
  portraitId       String?
  titleId          String?
  profileSyncedAt  DateTime?
  profilePayload   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  names            PlayerName[]
  membershipTerms  MembershipTerm[]
  snapshots        MemberSnapshot[]
  automationEvents AutomationEvent[]
  profileSnapshots PlayerProfileSnapshot[]
  twAssignments    PlayerAssignment[]
  twAttackAssignments AttackAssignment[]
}

model PlayerName {
  id        String   @id @default(cuid())
  playerId  String
  name      String
  firstSeen DateTime
  lastSeen  DateTime
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, lastSeen])
}

model MembershipTerm {
  id                  String          @id @default(cuid())
  guildId             String
  playerId            String
  state               MembershipState @default(ACTIVE)
  joinedAt            DateTime
  leftAt              DateTime?
  welcomeSentAt       DateTime?
  departureNotifiedAt DateTime?
  discordAccessRemovedAt DateTime?
  guild               Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player              Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guildId, playerId, joinedAt])
  @@index([guildId, state])
}

model GuildSnapshot {
  id             String           @id @default(cuid())
  guildId        String
  capturedAt     DateTime
  memberCount    Int
  galacticPower  BigInt
  characterPower BigInt
  shipPower      BigInt
  raidTickets    Int?
  rawPayload     Json?
  guild          Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members        MemberSnapshot[]

  @@unique([guildId, capturedAt])
  @@index([capturedAt])
}

model MemberSnapshot {
  id              String        @id @default(cuid())
  guildSnapshotId String
  playerId        String
  galacticPower   BigInt
  characterPower  BigInt?
  shipPower       BigInt?
  raidTickets     Int?
  lastActivityAt  DateTime?
  playerLevel     Int?
  memberRole      String?
  squadPower      Int?
  lifetimeSeasonScore BigInt?
  leagueId        String?
  guildXp         Int?
  rawPayload      Json?
  guildSnapshot   GuildSnapshot @relation(fields: [guildSnapshotId], references: [id], onDelete: Cascade)
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guildSnapshotId, playerId])
  @@index([playerId])
}

model PlayerProfileSnapshot {
  id                 String   @id @default(cuid())
  playerId           String
  capturedAt         DateTime @default(now())
  galacticLegends    Int
  unlockedUltimates  Int
  relicUnits         Int
  rosterUnits        Int
  datacrons          Int
  lifetimeSeasonScore BigInt?
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, capturedAt])
  @@index([capturedAt])
}

model GuildEvent {
  id          String         @id @default(cuid())
  guildId     String
  externalId  String?
  type        GuildEventType
  name        String
  startsAt    DateTime?
  endsAt      DateTime?
  finalResult Json?
  guild       Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  snapshots   EventSnapshot[]
  twPlans     TerritoryWarPlan[]

  @@unique([guildId, type, externalId])
  @@index([guildId, type, startsAt])
}

model EventSnapshot {
  id         String     @id @default(cuid())
  eventId    String
  capturedAt DateTime
  phase      String?
  payload    Json
  event      GuildEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, capturedAt])
}

model AutomationEvent {
  id               String           @id @default(cuid())
  guildId          String
  playerId         String?
  kind             String
  status           AutomationStatus @default(PENDING)
  title            String?
  summary          String
  metadata         Json?
  discordChannelId String?
  discordMessageId String?
  occurredAt       DateTime         @default(now())
  sentAt           DateTime?
  guild            Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player           Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([guildId, occurredAt])
  @@index([status, occurredAt])
}

model Recipe {
  id           String   @id
  slug         String   @unique
  name         String
  origin       String
  description  String
  ingredients  Json
  instructions Json
  beerPairings Json
  tone         String
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model RecipeSubmission {
  id            String                 @id @default(cuid())
  name          String
  origin        String?
  bread         String
  filling       String
  toppings      String
  instructions  String
  beerSuggestion String?
  submitterName String?
  notes         String?
  status        RecipeSubmissionStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, createdAt])
}

model StrategyTemplate {
  id          String             @id @default(cuid())
  guildId     String
  name        String
  description String?
  isBuiltIn   Boolean            @default(false)
  rules       Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  guild       Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plans       TerritoryWarPlan[]

  @@index([guildId])
}

model TerritoryWarPlan {
  id            String            @id @default(cuid())
  guildId       String
  eventId       String?
  templateId    String?
  clonedFromId  String?
  name          String
  status        TwPlanStatus      @default(DRAFT)
  version       Int               @default(1)
  createdBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  guild         Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  event         GuildEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  template      StrategyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  clonedFrom    TerritoryWarPlan? @relation("PlanClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones        TerritoryWarPlan[] @relation("PlanClone")
  zonePlans     ZonePlan[]
  assignments   PlayerAssignment[]
  attackAssignments AttackAssignment[]

  @@index([guildId, status])
  @@index([eventId])
}

model ZonePlan {
  id             String             @id @default(cuid())
  planId         String
  zoneId         Int
  purpose        String?
  targetCapacity Int                @default(25)
  note           String?
  updatedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  plan           TerritoryWarPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignments    PlayerAssignment[]

  @@unique([planId, zoneId])
}

model PlayerAssignment {
  id           String              @id @default(cuid())
  planId       String
  zonePlanId   String
  playerId     String
  squadKey     String
  priority     Int                 @default(0)
  officerNote  String?
  status       TwAssignmentStatus  @default(SUGGESTED)
  source       TwAssignmentSource  @default(RECOMMENDED)
  locked       Boolean             @default(false)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  plan         TerritoryWarPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  zonePlan     ZonePlan            @relation(fields: [zonePlanId], references: [id], onDelete: Cascade)
  player       Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([planId, zonePlanId])
  @@index([playerId])
}

model AttackAssignment {
  id               String          @id @default(cuid())
  planId           String
  zoneLabel        String
  enemySquad       String?
  assignedPlayerId String?
  status           TwAttackStatus  @default(UNASSIGNED)
  note             String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  plan             TerritoryWarPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignedPlayer   Player?          @relation(fields: [assignedPlayerId], references: [id], onDelete: SetNull)

  @@index([planId])
}
